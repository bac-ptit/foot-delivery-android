# Doxyfile - Cấu hình sinh tài liệu Doxygen cho dự án Đặt Món

# ─── Project ─────────────────────────────────────────────────────────────────
PROJECT_NAME           = "Dat Mon - Food Delivery Android"
PROJECT_BRIEF          = "He thong dat mon an truc tuyen - Android App + FastAPI Backend"
PROJECT_NUMBER         = "1.0"
OUTPUT_DIRECTORY       = docs

# ─── Input ───────────────────────────────────────────────────────────────────
INPUT                  = backend \
                         app/app/src/main/java/com/example/myapp
FILE_PATTERNS          = *.py *.kt
RECURSIVE              = YES
EXCLUDE                = .git .gradle build
EXCLUDE_PATTERNS       = */build/* */.gradle/* */test/*

# ─── Language ────────────────────────────────────────────────────────────────
OUTPUT_LANGUAGE        = Vietnamese

# ─── Extraction ──────────────────────────────────────────────────────────────
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# ─── Source browsing ─────────────────────────────────────────────────────────
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES

# ─── HTML output ─────────────────────────────────────────────────────────────
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
SEARCHENGINE           = YES

# ─── LaTeX / PDF output ─────────────────────────────────────────────────────
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES

# ─── Diagrams (graphviz) ────────────────────────────────────────────────────
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_DIAGRAMS         = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# ─── Preprocessing ──────────────────────────────────────────────────────────
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES

# ─── Kotlin support ─────────────────────────────────────────────────────────
EXTENSION_MAPPING      = kt=Java

# ─── Misc ────────────────────────────────────────────────────────────────────
GENERATE_TREEVIEW      = YES
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
